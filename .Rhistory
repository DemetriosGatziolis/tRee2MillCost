terra::terraOptions(memfrac=0.9, memmax=60)
## ------------------------------- USER INPUT ----------------------------------
## Inputs
rdName                 <- "C:/temp/FOUR_FRI_ROADS.shp"
rdField                <- "MAX_MPH"
facilityName           <- "C:/temp/FOUR_FRI_PSITES.shp"
facilityField          <- "PSITE_ID"
resourceName           <- "C:/temp/FOUR_FRI_PLOTS.shp"
resourceField          <- "PLOT"
rasterResolution       <- 20 ## meters or feet
costType               <- 1
## Outputs
roadRasterName         <- paste0("FOUR_FRI_speed_", rasterResolution, "m.tif")
movedFacilityName      <- paste0("FOUR_FRI_moved_mills_", rasterResolution, "m.gpkg")
movedResourceName      <- paste0("FOUR_FRI_moved_plots_", rasterResolution, "m.gpkg")
outCSVName             <- paste0("cost_", rasterResolution, "m.csv")
## ---------------------------- END OF USER INPUT ------------------------------
