if( shp.ext[2] %% resolution == 0.0 ) shp.ext[2] <- shp.ext[2] + 0.0001 ## xmax
if( shp.ext[4] %% resolution == 0.0 ) shp.ext[4] <- shp.ext[4] + 0.0001 ## ymax
